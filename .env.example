# Copy to .env (gitignored) — the launcher logs in with these automatically.

HF_TOKEN=<your Hugging Face write token>

# Kaggle — EITHER an access token (kaggle.com/settings -> Create Access Token):
KAGGLE_TOKEN=<your Kaggle access token>
# OR the API credentials from a kaggle.json (Create New Token) — uncomment:
# KAGGLE_USERNAME=<your Kaggle username>
# KAGGLE_KEY=<your Kaggle API key>
